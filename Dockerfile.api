# ── Cloud Native Pong — API / Lobby Server ─────────────────────────
# Multi-stage build: Go binary from golang:1.26-alpine → distroless.
# Runs in --mode=lobby to serve the API and WebSocket endpoints.
#
# Build:
#   docker build -t cloudnativepong-api:latest -f Dockerfile.api .
#
# Run:
#   docker run --rm -p 8080:8080 cloudnativepong-api:latest

# ── Build Stage ────────────────────────────────────────────────────
FROM docker.io/golang:1.27-alpine AS builder

RUN apk add --no-cache \
    ca-certificates=20260611-r0 \
    tzdata=2026c-r0

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY main.go ./
COPY diag.go ./
COPY admission/ ./admission/
COPY db/ ./db/
COPY game/ ./game/
COPY lobby/ ./lobby/
COPY metrics/ ./metrics/
COPY telemetry/ ./telemetry/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /pong .

# ── Final Stage ────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7

# Metadata labels
LABEL org.opencontainers.image.title="Cloud Native Pong — API / Lobby" \
      org.opencontainers.image.description="Pong lobby API server: room management, K8s pod orchestration, WebSocket compatibility and WebTransport routing" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.created="2025-07-30T00:00:00Z" \
      org.opencontainers.image.source="https://github.com/cloudnativepong/cloudnativepong" \
      org.opencontainers.image.url="https://cloudnativepong.dev" \
      org.opencontainers.image.vendor="Cloud Native Pong" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.ref.name="latest"

# Keep the small distroless runtime, and copy the exact CA/timezone data used
# by the builder so Kubernetes API/TLS calls and log timestamps are stable.
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
# Static files (served by Caddy in production, but included for standalone use)
COPY static/ /static/

# Binary
COPY --from=builder /pong /pong

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/pong", "--healthcheck"]

USER 65532:65532
ENTRYPOINT ["/pong", "--mode=lobby"]
