# ── Cloud Native Pong — Static File Server ──────────────────────────
# Serves HTML, CSS, JS via nginx:alpine on port 8080.
#
# Build:
#   docker build -t cloudnativepong-static:latest -f Dockerfile.static .
#
# Run:
#   docker run --rm -p 8080:8080 cloudnativepong-static:latest

FROM docker.io/nginx:alpine

ARG BUILD_SHA=dev
ARG BUILD_REPOSITORY=macel94/cloudnativepong

# Metadata labels (Open Containers Initiative)
LABEL org.opencontainers.image.title="Cloud Native Pong — Static Server" \
      org.opencontainers.image.description="Serves the Pong frontend (HTML, CSS, JS) via nginx with CORS and WebSocket headers" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.created="2025-07-30T00:00:00Z" \
      org.opencontainers.image.source="https://github.com/cloudnativepong/cloudnativepong" \
      org.opencontainers.image.url="https://cloudnativepong.dev" \
      org.opencontainers.image.vendor="Cloud Native Pong" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.ref.name="latest"

# Remove default nginx static files
RUN rm -rf /usr/share/nginx/html/*

# Copy static content
COPY static/ /usr/share/nginx/html/

# Copy nginx configuration
COPY nginx-main.conf /etc/nginx/nginx.conf
COPY static/nginx.conf /etc/nginx/conf.d/default.conf

# Replace the local development marker with the exact source commit used for
# this image. A production image must carry a full Git SHA so the UI link is
# unambiguous and reviewable.
RUN set -euo pipefail; \
    printf '%s' "$BUILD_REPOSITORY" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'; \
    if [ "$BUILD_SHA" = dev ]; then \
      short_sha=dev; \
      commit_path=commits/main; \
    elif printf '%s' "$BUILD_SHA" | grep -Eq '^[0-9a-fA-F]{40}$'; then \
      short_sha="$(printf '%s' "$BUILD_SHA" | cut -c1-7)"; \
      commit_path="commit/$BUILD_SHA"; \
    else \
      echo 'BUILD_SHA must be dev or a full 40-character Git SHA' >&2; \
      exit 1; \
    fi; \
    sed -i \
      -e "s#sha: 'dev'#sha: '$BUILD_SHA'#" \
      -e "s#shortSha: 'dev'#shortSha: '$short_sha'#" \
      -e "s#https://github.com/macel94/cloudnativepong/commits/main#https://github.com/$BUILD_REPOSITORY/$commit_path#" \
      /usr/share/nginx/html/build-info.js

# Port exposed to the gateway
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["wget", "--spider", "--quiet", "http://127.0.0.1:8080/health"]

USER 101:101

# Run nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
