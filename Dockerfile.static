# ── Cloud Native Pong — Static File Server ──────────────────────────
# Serves HTML, CSS, JS via Caddy on port 8080.

FROM docker.io/library/caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d

ARG BUILD_SHA=dev
ARG BUILD_REPOSITORY=macel94/cloudnativepong

LABEL org.opencontainers.image.title="Cloud Native Pong — Static Server" \
      org.opencontainers.image.description="Serves the Pong frontend via Caddy with WebSocket compatibility and WebTransport capability discovery" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.source="https://github.com/cloudnativepong/cloudnativepong" \
      org.opencontainers.image.licenses="MIT"

COPY static/ /srv/
COPY static/Caddyfile /etc/caddy/Caddyfile

# Replace the local development marker with the exact source commit used for
# this image. A production image must carry a full Git SHA.
RUN set -eux; \
    printf '%s' "$BUILD_REPOSITORY" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'; \
    if [ "$BUILD_SHA" = dev ]; then \
      short_sha=dev; \
      commit_path=commits/main; \
    elif printf '%s' "$BUILD_SHA" | grep -Eq '^[0-9a-fA-F]{40}$'; then \
      short_sha="$(printf '%s' "$BUILD_SHA" | cut -c1-7)"; \
      commit_path="commit/$BUILD_SHA"; \
    else \
      echo 'BUILD_SHA must be dev or a full 40-character Git SHA' >&2; \
      exit 1; \
    fi; \
    sed -i \
      -e "s#sha: 'dev'#sha: '$BUILD_SHA'#" \
      -e "s#shortSha: 'dev'#shortSha: '$short_sha'#" \
      -e "s#https://github.com/macel94/cloudnativepong/commits/main#https://github.com/$BUILD_REPOSITORY/$commit_path#" \
      /srv/build-info.js

# The upstream image grants cap_net_bind_service to Caddy. This workload
# listens on 8080 and runs with allowPrivilegeEscalation=false, so retaining
# that file capability makes hardened Kubernetes runtimes reject execve.
RUN setcap -r /usr/bin/caddy

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/usr/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile"]

USER 1000:1000
ENTRYPOINT ["/usr/bin/caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
