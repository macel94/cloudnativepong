# ── Cloud Native Pong — Gateway Caddyfile ──────────────────────────
# Uses Caddy environment variable substitution {env.*} for K8s DNS names.
# Caddy auto-handles HTTP/2 and WebSocket upgrades.
{
    admin off
}

# Listen on port 80
:80 {
    handle /api/* {
        reverse_proxy {env.API_ADDR}
    }

    handle /rooms/* {
        reverse_proxy {env.API_ADDR}
    }

    handle /style.css {
        reverse_proxy {env.STATIC_ADDR}
    }
    handle /lobby.js {
        reverse_proxy {env.STATIC_ADDR}
    }
    handle /game.js {
        reverse_proxy {env.STATIC_ADDR}
    }
    handle /index.html {
        reverse_proxy {env.STATIC_ADDR}
    }
    handle /game.html {
        reverse_proxy {env.STATIC_ADDR}
    }
    handle / {
        reverse_proxy {env.STATIC_ADDR}
    }

    respond /health 200
}