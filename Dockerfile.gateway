# Cloud Native Pong — Caddy HTTP gateway.
#
# Caddy handles HTTP routing and WebSocket upgrades. Native WebTransport is
# terminated by the Go lobby, since standard Caddy reverse_proxy does not
# proxy WebTransport sessions.

# Rebuild the same standard Caddy release with the fixed Go/HTTP2 stack.
FROM docker.io/library/golang:1.27.3-alpine@sha256:f2c872bcee949b7be9c490efd02b48a8a2fbf947cdf533f1c58525ec9d8170fd AS caddy-build
ENV GOTOOLCHAIN=local
WORKDIR /src
COPY build/caddy/go.mod build/caddy/go.sum ./
RUN go mod download
COPY build/caddy/main.go ./
RUN CGO_ENABLED=0 go list -deps . > /tmp/caddy-deps.txt \
    && ! grep -Eq '^golang.org/x/crypto/openpgp(/|$)' /tmp/caddy-deps.txt
RUN CGO_ENABLED=0 go build -p=1 -trimpath -ldflags="-s -w" -o /out/caddy .

FROM docker.io/library/caddy:2.11.7-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f

LABEL org.opencontainers.image.title="Cloud Native Pong — Gateway" \
      org.opencontainers.image.description="Caddy gateway routing static assets, API requests, and WebSocket rooms" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.licenses="MIT"

COPY gateway/Caddyfile /etc/caddy/Caddyfile

# Refresh Alpine packages at build time so fixed OS vulnerabilities in the
# vendor layer cannot be carried into the published immutable image.
RUN apk upgrade --no-cache

# The upstream image grants cap_net_bind_service to Caddy. This workload
# listens on 8080 and runs with allowPrivilegeEscalation=false, so retaining
# that file capability makes hardened Kubernetes runtimes reject execve.
RUN setcap -r /usr/bin/caddy
COPY --from=caddy-build /out/caddy /usr/bin/caddy
RUN capabilities="$(getcap /usr/bin/caddy)" && test -z "$capabilities"

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/usr/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile"]

USER 1000:1000
ENTRYPOINT ["/usr/bin/caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
