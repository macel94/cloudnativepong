# Cloud Native Pong — Caddy HTTP gateway.
#
# Caddy handles HTTP routing and WebSocket upgrades. Native WebTransport is
# terminated by the Go lobby, since standard Caddy reverse_proxy does not
# proxy WebTransport sessions.

FROM docker.io/library/caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d

LABEL org.opencontainers.image.title="Cloud Native Pong — Gateway" \
      org.opencontainers.image.description="Caddy gateway routing static assets, API requests, and WebSocket rooms" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.licenses="MIT"

COPY gateway/Caddyfile /etc/caddy/Caddyfile

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/usr/bin/caddy", "validate", "--config", "/etc/caddy/Caddyfile"]

USER 1000:1000
ENTRYPOINT ["/usr/bin/caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
