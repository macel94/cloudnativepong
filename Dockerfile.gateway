# Cloud Native Pong — Kubernetes gateway.
# NGINX provides the browser-facing HTTP/WebSocket reverse proxy.

FROM docker.io/nginx:alpine

COPY nginx-main.conf /etc/nginx/nginx.conf

LABEL org.opencontainers.image.title="Cloud Native Pong — Gateway" \
      org.opencontainers.image.description="NGINX gateway routing static assets, API requests, and WebSocket rooms" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.licenses="MIT"

COPY gateway/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["wget", "--spider", "--quiet", "http://127.0.0.1:8080/health"]

USER 101:101
CMD ["nginx", "-g", "daemon off;"]
