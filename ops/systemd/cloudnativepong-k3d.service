[Unit]
Description=Cloud Native Pong k3d Kubernetes cluster
Wants=network-online.target
After=network-online.target local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
# k3d uses Podman containers directly on this host. Keep the existing
# cluster and its persistent volumes; do not recreate the cluster at boot.
ExecStart=/bin/sh -c '/usr/bin/podman start k3d-pong-server-0; sleep 8; /usr/bin/podman start k3d-pong-agent-0 k3d-pong-agent-1; sleep 8; /usr/bin/podman start k3d-pong-serverlb'
ExecStop=/usr/bin/podman stop --time 30 k3d-pong-serverlb k3d-pong-agent-1 k3d-pong-agent-0 k3d-pong-server-0
TimeoutStartSec=120
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
