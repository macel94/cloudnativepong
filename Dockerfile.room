# ── Cloud Native Pong — Room Server ────────────────────────────────
# Multi-stage build: pinned Go 1.27.3 binary → refreshed distroless.
# Runs in --mode=room for dedicated game room pods.
# Room ID and lobby address are injected at runtime via --room-id and --lobby-addr.
#
# Build:
#   docker build -t cloudnativepong-room:latest -f Dockerfile.room .
#
# Run:
#   docker run --rm -p 8080:8080 \
#     cloudnativepong-room:latest \
#     --room-id=abc123 --lobby-addr=lobby:8080

# ── Build Stage ────────────────────────────────────────────────────
FROM docker.io/library/golang:1.27.3-alpine@sha256:f2c872bcee949b7be9c490efd02b48a8a2fbf947cdf533f1c58525ec9d8170fd AS builder
ENV GOTOOLCHAIN=local

RUN apk add --no-cache \
    ca-certificates=20261020-r0 \
    tzdata=2026e-r0

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY main.go ./
COPY diag.go ./
COPY admission/ ./admission/
COPY db/ ./db/
COPY game/ ./game/
COPY lobby/ ./lobby/
COPY metrics/ ./metrics/
COPY telemetry/ ./telemetry/

# Prevent the unmaintained OpenPGP package from entering the binary.
RUN CGO_ENABLED=0 go list -deps . > /tmp/pong-deps.txt \
    && ! grep -Eq '^golang.org/x/crypto/openpgp(/|$)' /tmp/pong-deps.txt
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -o /pong .

# ── Final Stage ────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian13:nonroot@sha256:d62067879de890a1def9da0e7766b7d20810a5e5555cef8506b752437d7a3e88

# Metadata labels
LABEL org.opencontainers.image.title="Cloud Native Pong — Room Server" \
      org.opencontainers.image.description="Dedicated game room pod: runs a single Pong game instance" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.created="2025-07-30T00:00:00Z" \
      org.opencontainers.image.source="https://github.com/cloudnativepong/cloudnativepong" \
      org.opencontainers.image.url="https://cloudnativepong.dev" \
      org.opencontainers.image.vendor="Cloud Native Pong" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.ref.name="latest"

# Keep the small distroless runtime, and copy the exact CA/timezone data used
# by the builder so callbacks and log timestamps are stable.
COPY --from=builder /usr/share/zoneinfo /usr/share/zoneinfo
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
# Binary
COPY --from=builder /pong /pong

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/pong", "--healthcheck"]

USER 65532:65532
ENTRYPOINT ["/pong", "--mode=room"]
